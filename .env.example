# Keep your existing bot settings. This example contains no credentials.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Dashboard starts with the bot; Wispbyte supplies HTTPS for this subdomain.
DASHBOARD_ENABLED=1
AGE_ORIGIN=https://number-one.wispbyte.app
AGE_PORT=16243
# setup serves a locked public portal. Never use demo on Wispbyte.
AGE_MODE=setup
AGE_DB=data/age-verification.sqlite

# Fill these privately on Wispbyte before switching AGE_MODE to discord.
# Bot token/application ID above are reused automatically.
AGE_CLIENT_SECRET=
AGE_GUILD_ID=
AGE_REVIEWER_ROLE_ID=
AGE_VERIFIED_ROLE_ID=
