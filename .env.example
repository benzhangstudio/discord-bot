# Copy this file to `.env` in the server's main folder and fill it in.
# Values come from https://discord.com/developers/applications -> your app.

# Bot tab -> Reset Token
DISCORD_TOKEN=

# General Information / OAuth2 tab
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The public address of your Wispbyte dashboard link, no trailing slash.
# Add  <PUBLIC_URL>/auth/callback  as a Redirect in the OAuth2 tab.
PUBLIC_URL=http://localhost:3000

# Any long random string. Used to sign login cookies; changing it logs everyone out.
SESSION_SECRET=

# Optional: a test server ID. Slash commands update there instantly
# (global commands can take a while to appear everywhere).
DEV_GUILD_ID=

# Optional: Wispbyte sets SERVER_PORT automatically. Only set PORT for local testing.
# PORT=3000
