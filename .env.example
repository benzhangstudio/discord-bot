# Number One public dashboard: operator settings only.
# Keep your existing bot credentials private on Wispbyte.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
AGE_CLIENT_SECRET=

DASHBOARD_ENABLED=1
AGE_ORIGIN=https://number-one.wispbyte.app
AGE_PORT=16243
AGE_DB=data/age-verification.sqlite
# With AGE_CLIENT_SECRET present, hosted sign-in opens automatically.
# Optional maintenance lock: AGE_MODE=setup
# Never use AGE_MODE=demo on Wispbyte.
# Server IDs and reviewer/verified roles are selected on the public website.
# Optional message-based automod. Also enable Message Content Intent in Developer Portal.
MODERATION_MESSAGE_CONTENT=0
